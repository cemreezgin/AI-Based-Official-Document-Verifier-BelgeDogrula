OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
QWEN_TIMEOUT_SECONDS=120
QWEN_REVIEW_MIN_SIMILARITY=0.75
AUTO_MATCH_SIMILARITY=0.85
CANDIDATE_PREFIX_LINES=12
CANDIDATE_PREFIX_SIMILARITY=0.35
PADDLEOCR_EXECUTABLE=paddleocr
PADDLEOCR_DEVICE=cpu
PADDLEOCR_ENGINE=transformers
PADDLEOCR_VERSION=PP-OCRv6
ENABLE_RESTORMER=true
FETCH_OFFICIAL_DOCUMENT=true
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=10
MAX_OFFICIAL_DOCUMENTS=5
MINIMUM_MATCH_CONFIDENCE=0.80
ALLOWED_ORIGINS=http://localhost:3000
